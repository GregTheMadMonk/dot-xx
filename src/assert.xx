/**
 * @file assert.xx
 * @brief Main and only file of the `dxx.assert` module
 */

/**
 * @brief Provides `test` and `check` function-like objects. Uses `<stacktrace>`
 *        to display stack trace on failure if possible
 *
 * Exports two function-like objects:
 * * @ref dxx::assert::test  that asserts if the condition is `true`
 * * @ref dxx::assert::check that wraps a value or reference in a special
 *                           "checker" object for further comparisons
 *
 * All failed checks throw @ref dxx::assert::Failure by default (customizeable)
 *
 * Custom `operator[]` is used to invoke the same checks in all build types
 * instead of just __Debug__ mode builds, see documentation for @ref test_with
 * and @ref check_with
 */
export module dxx.assert;

export import :checker;
export import :failure;
export import :location;

import std;

/**
 * @brief Main namespace for @ref dxx.assert module
 */
namespace dxx::assert {

template <typename TFailure>
struct Test {
    static inline void operator[](bool condition, Location l = {}) {
        if (condition) return;
        throw TFailure{l};
    } // <-- operator[]

    static inline void operator()(bool condition, Location l = {}) {
#ifndef NDEBUG
        Test::operator[](condition, l);
#endif
    } // <-- operator()
}; // <-- struct Test<TFailure>

/**
 * @brief Check if the condition is `true` and throw if it's not
 *
 * @tparam TFailure
 *         exception type to be thrown on failure
 *
 * Different calling methods decide whether the assertion is performed in
 * all builds, or in __Debug__ builds only:
 *
 * ```c++
 * test(false); // fires in debug build only
 * test[false]; // fires in all builds
 * ```
 */
export
template <std::constructible_from<const Location&> TFailure = Failure>
constexpr Test<TFailure> test_with {};

/**
 * @brief See @ref test_with
 */
export
constexpr auto test = test_with<Failure>;

template <typename TFailure>
struct Check {
    template <typename T>
    [[nodiscard]]
    static inline auto operator[](T&& t, Location l = {})
    { return Checker<T, TFailure>{std::forward<T>(t), l}; }

    template <typename T>
    [[nodiscard]]
    static inline auto operator()(T&& t, Location l = {}) {
#ifndef NDEBUG
        return Check::operator[](std::forward<T>(t), l);
#else
        return DummyChecker{};
#endif
    } // <-- operator()
}; // <-- struct Check<TFailure>

/**
 * @brief Begin a check on a value
 *
 * @tparam TFailure
 *         exception type to be thrown on failure
 *
 * Checks allow to output more detailed information about a failed assertion,
 * e.g. the values that are being compared etc. Debug/all-build behavior is
 * similar to @ref test:
 *
 * ```c++
 * check(42) == 43; // fires in debug build only
 * check[42] == 43; // fires in all builds
 * ```
 *
 * In both cases, exception messages contain `42 != 43`. Other comparison
 * operators are supported.
 */
export
template <
    std::constructible_from<
        const Location&, const std::string&
    > TFailure = Failure
> constexpr Check<TFailure> check_with {};

/**
 * @brief See @ref check_with
 */
export
constexpr auto check = check_with<Failure>;

} // <-- namespace dxx::assert
